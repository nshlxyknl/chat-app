# ===== Frontend (Next.js on Vercel) =====
# Public URL of the deployed Socket.IO server (no trailing slash)
NEXT_PUBLIC_SOCKET_URL=https://your-socket-server.onrender.com

# ===== Socket server (server.js on Render/Railway) =====
# Render/Railway inject PORT; keep 3001 for local development only
PORT=3001

# Comma-separated list of allowed frontend origins
CLIENT_URL=https://your-app.vercel.app
